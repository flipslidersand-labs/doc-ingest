# Qdrant vector DB (leave blank for unauthenticated localhost)
QDRANT_URL=http://192.168.1.100:6333
QDRANT_API_KEY=

# Embedding service (leave blank to omit X-API-Key header)
EMBED_URL=http://192.168.1.100:9092/embed/batch
EMBED_API_KEY=

# LLM distillation (Ollama preferred, Anthropic as fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_TIMEOUT=120

# Optional: Discord webhook for sync notifications
DISCORD_WEBHOOK_URL=

# Optional: parallel fetch workers for sync_external (default: 4)
SYNC_WORKERS=4

# --- C plan: GPU primary (dev-nodee:9093) + MINIPC fallback (localhost:9092) ---
# EMBED_URL points to dev-nodee GPU service (primary, fast but not always-on).
# EMBED_URL_FALLBACK points to MINIPC ONNX INT8 service (always-on fallback).
# Probe timeout for primary is short (EMBED_TIMEOUT_PRIMARY=10s) so fallback is fast.
#
# EMBED_URL=http://192.168.68.61:9093/embed/batch
# EMBED_API_KEY=<gpu-svc-api-key>
# EMBED_URL_FALLBACK=http://192.168.68.63:9092/embed/batch
# EMBED_API_KEY_FALLBACK=<minipc-api-key>
# EMBED_TIMEOUT_PRIMARY=10
# EMBED_BATCH=64   # GPU-optimal batch size

# --- ONNX GPU embedding (local on dev-nodee, bypass HTTP entirely) ---
# Alternative: run doc-ingest directly on dev-nodee with local ONNX GPU inference.
# Requires: onnxruntime-gpu==1.20.2 + CUDA compat libs (see e5-onnx-gpu repo)
#
# EMBED_BACKEND=onnx_gpu
# ONNX_MODEL_PATH=/opt/gpu-embedding-svc/models/model_encoder_only.onnx
# EMBED_BATCH=64
