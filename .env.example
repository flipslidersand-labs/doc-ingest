# Qdrant vector DB (leave blank for unauthenticated localhost)
QDRANT_URL=http://192.168.1.100:6333
QDRANT_API_KEY=

# Embedding service (leave blank to omit X-API-Key header)
EMBED_URL=http://192.168.1.100:9092/embed/batch
EMBED_API_KEY=
# Optional: fallback endpoint (C案: GPU primary + MINIPC CPU fallback)
# When set, EMBED_URL is tried first; on connect error or 501, EMBED_FALLBACK_URL is used.
# EMBED_FALLBACK_URL=http://192.168.68.63:9092/embed/batch

# LLM distillation (Ollama preferred, Anthropic as fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_TIMEOUT=120

# Optional: Discord webhook for sync notifications
DISCORD_WEBHOOK_URL=

# Optional: parallel fetch workers for sync_external (default: 4)
SYNC_WORKERS=4

# --- ONNX GPU embedding (dev-nodee GTX1080 / sm_61) ---
# Set EMBED_BACKEND=onnx_gpu to bypass MINIPC HTTP and infer locally.
# Requires: onnxruntime-gpu==1.19.2, libcurand10, libcufft11 (apt)
# LD_LIBRARY_PATH=/usr/local/lib/ollama/cuda_v12:/usr/local/lib/ollama/mlx_cuda_v13:$LD_LIBRARY_PATH
#
# EMBED_BACKEND=onnx_gpu
# ONNX_MODEL_PATH=/path/to/e5-base-onnx/model.onnx
# EMBED_BATCH=64   # GPU-optimal (vs 16 for HTTP/CPU)
